# Copy to .env for local use. Never commit real values.
SMSMCPHUB_HOST=0.0.0.0
SMSMCPHUB_PORT=8000
SMSMCPHUB_DATABASE_PATH=./data/smsmcphub.db
SMSMCPHUB_SAVE_RAW_PAYLOAD=false
SMSMCPHUB_RETENTION_DAYS=30
SMSMCPHUB_MCP_PATH=/mcp

# Optional: protect the MCP endpoint with Authorization: Bearer <token>.
SMSMCPHUB_MCP_TOKEN=

# Optional: validate SmsForwarder HMAC signatures.
SMSFORWARDER_SECRET=
SMSFORWARDER_REQUIRE_SIGNATURE=false
SMSFORWARDER_SIGNATURE_TOLERANCE_SECONDS=3600

# Optional JSON object mapping for custom SmsForwarder templates.
SMSFORWARDER_MAPPING=
